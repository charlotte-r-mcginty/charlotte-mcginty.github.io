source "https://rubygems.org"
# Hello! This is the default Gemfile for new Jekyll apps. You may wish to
# use different dependencies in reality though. See the actual default
# template (by running `jekyll new-theme`) to see if rbenv/rvm/bundler is
# installed.
#
# If you're migrating and see this message, check the following doc:
# https://jekyllrb.com/docs/step-by-step/01-setup/

# If you have any plugins, put them here!
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.12"
  gem "jekyll-seo-tag", "~> 2.8"
end

# Windows and JRuby does not include zoneinfo files, so bundle the tzinfo-data gem
# and associated library.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1"
  gem "tzinfo-data"
end

# Lock `http_parser.rb` to `v0.6.0`
gem "http_parser.rb", "~> 0.6.0"

gem "webrick", "~> 1.8"

gem "minima", "~> 2.5"
